# ─────────────────────────────────────────────────────────────────────────────
#  AlgoMetis AI setup: copy this file to .env and paste in as many FREE keys as you can.
#  Every key becomes a backup. If one provider hits its free limit or goes down, the next one takes over
#  automatically. The offline rule-based mode is used only if ALL of them are unavailable.
#  After editing: restart (npm start), then test every key with:  npm run check-llm
# ─────────────────────────────────────────────────────────────────────────────

# 1. Google Gemini   (free)  https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 2. Groq            (free)  https://console.groq.com/keys
GROQ_API_KEY=

# 3. OpenRouter      (free models)  https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# 4. Cerebras        (free)  https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# 5. Mistral         (free "Experiment" plan)  https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Paid, optional (used after the free ones)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Local, optional: a model running on your own PC with Ollama (https://ollama.com). Never rate limited.
#   ollama pull qwen2.5:7b    then uncomment:
# OLLAMA_URL=http://localhost:11434/v1

# ── Optional tuning ──────────────────────────────────────────────────────────
# Order of the chain (default: gemini,groq,openrouter,cerebras,mistral,openai,anthropic,ollama)
# LLM_CHAIN=groq,gemini,openrouter,cerebras,mistral

# Several keys for one provider (e.g. from different accounts) are rotated before moving on:
# GROQ_API_KEY=gsk_first,gsk_second

# Models per provider, tried in order. Each free model usually has its own quota.
# Model names change over time; if check-llm says "model not available", change them here.
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.6-flash
# GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,llama-3.3-70b-versatile
# OPENROUTER_MODELS=openrouter/free
# CEREBRAS_MODELS=gpt-oss-120b,qwen-3-235b-a22b-instruct-2507
# MISTRAL_MODELS=mistral-small-latest

# Requests per minute we allow ourselves per provider (kept under the free limit to avoid 429s):
# GEMINI_RPM=8
# GROQ_RPM=25

# LLM_TIMEOUT_MS=30000          # give up on one provider after this long and try the next
# LLM_MAX_WAIT_MS=8000          # if all are briefly rate-limited, wait up to this long before using offline rules
# LLM_OFFLINE_FALLBACK=on       # "off" = show an error instead of offline answers when every provider is down

# Old single-provider style still works (it goes first in the chain):
# LLM_PROVIDER=gemini
# LLM_API_KEY=
# LLM_MODEL=

PORT=8787
# DATA_DIR=data
# RATE_LIMIT_MAX=40
# RATE_LIMIT_WINDOW_MS=300000
# AGENT_MAX_TURNS=12
