# Copy this file to .env and fill in ONE provider.
# With no provider/key, AlgoMetis runs in OFFLINE DEMO MODE (rule-based stand-in, no AI).

# gemini | groq | openai | anthropic | openrouter | ollama | mock
LLM_PROVIDER=gemini
LLM_API_KEY=

# Optional: override the default model for the provider (model names change over time).
#   gemini default:    gemini-2.5-flash          (free tier key: https://aistudio.google.com)
#   groq default:      llama-3.3-70b-versatile   (free tier key: https://console.groq.com)
#   openai default:    gpt-4o-mini
#   anthropic default: claude-sonnet-5-5
#   ollama default:    qwen2.5:7b                (local, no key; needs a tool-calling model)
# LLM_MODEL=

# Optional: any other OpenAI-compatible endpoint (set LLM_PROVIDER to any name not listed above).
# LLM_BASE_URL=https://my-endpoint.example.com/v1

PORT=8787
# DATA_DIR=data
# RATE_LIMIT_MAX=40
# RATE_LIMIT_WINDOW_MS=300000
# AGENT_MAX_TURNS=12
