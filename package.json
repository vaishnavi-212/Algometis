{
  "name": "algometis",
  "version": "9.0.0",
  "description": "AlgoMetis: agentic algorithm tutor, interactive visualizers, practice games, and student C-code review.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node server/index.js",
    "dev": "node scripts/dev.mjs",
    "test": "node --test tests/*.test.mjs",
    "setup": "npm install && npm run build",
    "check-llm": "node scripts/check-llm.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
